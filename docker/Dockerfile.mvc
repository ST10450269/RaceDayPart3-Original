FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/RaceDay.Contracts/RaceDay.Contracts.csproj src/RaceDay.Contracts/
COPY src/RaceDay.Mvc/RaceDay.Mvc.csproj src/RaceDay.Mvc/
RUN dotnet restore src/RaceDay.Mvc/RaceDay.Mvc.csproj
COPY src/ src/
RUN dotnet publish src/RaceDay.Mvc/RaceDay.Mvc.csproj -c Release -o /app/publish --no-restore
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "RaceDay.Mvc.dll"]
