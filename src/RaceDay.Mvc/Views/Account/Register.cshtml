@model RaceDay.Mvc.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<h1>Create account</h1>
<form asp-action="Register" method="post" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" autocomplete="name" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
        <small class="form-text">At least 12 characters, with uppercase, lowercase, a number, and a symbol.</small>
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-select">
            <option value="Participant">Participant</option>
            <option value="Organiser">Organiser</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ContactNumber" class="form-label">Contact number</label>
        <input asp-for="ContactNumber" class="form-control" autocomplete="tel" />
        <span asp-validation-for="ContactNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" autocomplete="address-level2" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create account</button>
    <a asp-action="Login" class="btn btn-link">Back to sign in</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
