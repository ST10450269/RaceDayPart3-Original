@model IReadOnlyList<RaceDay.Contracts.EventSummary>
@{
    ViewData["Title"] = "Upcoming events";
}
<h1>Upcoming RaceDay events</h1>
@if (ViewData["ApiError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
@if (Model.Count == 0)
{
    <p>No published events are available right now.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Event</th><th>Date (UTC)</th><th>Location</th><th>Distance</th><th>Type</th></tr></thead>
            <tbody>
            @foreach (var raceEvent in Model)
            {
                <tr>
                    <td>@raceEvent.Name</td>
                    <td>@raceEvent.EventDate.ToString("yyyy-MM-dd")</td>
                    <td>@raceEvent.Location</td>
                    <td>@raceEvent.DistanceKm km</td>
                    <td>@raceEvent.EventType</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
