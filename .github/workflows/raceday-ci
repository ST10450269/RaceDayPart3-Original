name: RaceDay Parts 1 to 3 CI
on:
  push:
  pull_request:
jobs:
  validate-plan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate Part 1 deliverables
        run: |
          test -s docs/RaceDay_ERD.png
          test -s docs/RaceDay_API_Endpoint_Plan.md
          test -s docs/RaceDay_Database.sql
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'
      - name: Restore dependencies
        run: dotnet restore RaceDay.sln
      - name: Build all projects
        run: dotnet build RaceDay.sln -c Release --no-restore
      - name: Run API tests
        run: dotnet test RaceDay.sln -c Release --no-build --logger "trx;LogFileName=tests.trx"
      - name: Upload test report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: '**/TestResults/*.trx'
